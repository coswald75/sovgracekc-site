# Resend — used by scripts AND by the /visit/ Sunday form (functions/api/sunday-visit.js).
# For the live form, set these as Cloudflare Pages secrets (never commit values):
#   wrangler pages secret put RESEND_API_KEY --project-name=sovgracekc
#   wrangler pages secret put RESEND_FROM --project-name=sovgracekc
# RESEND_FROM must be a verified sender (e.g. Providence Community Church <reports@sermonsteward.com>).
# The function emails chris@sovgracekc.org. Same names as below — no extra keys.
RESEND_API_KEY=
RESEND_FROM=
