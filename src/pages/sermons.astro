---
import Base from '../layouts/Base.astro';

const sermons = [
  {
    title: 'The Mechanics of Happiness',
    date: 'July 12, 2026',
    passage: 'Ecclesiastes 5:18-19, 6:1-3',
    audio: 'https://sermons-cdn.sermonsteward.com/providence-community-church/the-mechanics-of-happiness-2026-07-12.mp3',
    page: 'https://sermonsteward.com/ProvidenceLenexa/sermons/the-mechanics-of-happiness-2026-07-12',
    thesis: 'Contentment is not a circumstantial achievement but a complex gift from God that we are responsible to pursue through the gospel, and without it we will inevitably alienate those we love and forfeit the ability to enjoy what God has given.',
  },
  {
    title: 'Friendship',
    date: 'July 5, 2026',
    passage: 'Ecclesiastes 4:7-12',
    audio: 'https://sermons-cdn.sermonsteward.com/providence-community-church/friendship-2026-07-05.mp3',
    page: 'https://sermonsteward.com/ProvidenceLenexa/sermons/friendship-2026-07-05',
    thesis: 'Friendship is a great glory and potent means of grace, but like other means of grace, it rarely feels profound in the moment — it mostly just feels like doing life together, and we should treat it pragmatically rather than with romanticized expectations that rob us of contentment.',
  },
  {
    title: 'Ecclesiastes as Narcan',
    date: 'June 28, 2026',
    passage: 'Ecclesiastes 2:13–3:22, 4:4',
    audio: 'https://sermons-cdn.sermonsteward.com/providence-community-church/ecclesiastes-as-narcan-2026-06-28.mp3',
    page: 'https://sermonsteward.com/ProvidenceLenexa/sermons/ecclesiastes-as-narcan-2026-06-28',
    thesis: "The book of Ecclesiastes serves as spiritual Narcan to wake us from worldly intoxication, and while the Preacher's prescription to enjoy life and fear God is valid, Jesus the greater Solomon completes the picture by revealing that eternal life begins with enjoying the fruit of His redemptive toil on the cross.",
  },
  {
    title: 'Ecclesiastes — Vapor, Vanity, and the Gift of God',
    date: 'June 21, 2026',
    passage: 'Ecclesiastes 1:1–11:10',
    audio: 'https://sermons-cdn.sermonsteward.com/providence-community-church/ecclesiastes-vapor-vanity-and-the-gift-of-god-2026-06-21.mp3',
    page: 'https://sermonsteward.com/ProvidenceLenexa/sermons/ecclesiastes-vapor-vanity-and-the-gift-of-god-2026-06-21',
    thesis: "True contentment is found not in the pursuit of exceptional pleasures or achievements, but in receiving each ordinary day as God's gift and resting in the gospel assurance that God is pleased with us in Christ.",
  },
];
---
<Base
  title="Sermons | Providence Community Church | Church in Lenexa, KS"
  description="Get an introduction to the preaching at Providence Community Church. Listen to or watch a sermon here on the website or on your favorite podcast app."
  path="/sermons/"
>
  <section style="padding:56px 0;">
    <div class="wrap">
      <h1 class="masthead" style="font-size:clamp(2.2rem,5.5vw,3.8rem);">Sermons</h1>
      <div class="two-col">
        <p>We primarily teach the Bible verse-by-verse and chapter-by-chapter, and apply the truth to relationships, work, and life. The sermon usually lasts somewhere between 35&ndash;40 minutes.</p>
        <div>
          <p>Listen here, browse the full archive, or subscribe on your favorite podcast app.</p>
          <p style="display:flex; gap:22px; flex-wrap:wrap;">
            <a class="cta-link" href="https://sermonsteward.com/ProvidenceLenexa/sermons/" target="_blank" rel="noopener">Full archive</a>
            <a class="cta-link" href="https://podcasts.apple.com/us/podcast/the-providence-podcast/id1721017934" target="_blank" rel="noopener">Apple</a>
            <a class="cta-link" href="https://open.spotify.com/show/0OoTEDDOEp27qkCYXcMg7T" target="_blank" rel="noopener">Spotify</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap side-grid-wrap">
      <div class="side-label">Recent Sermons</div>
      <div>
        {sermons.map((s, i) => (
          <article style={`padding: ${i === 0 ? '0' : '44px'} 0 44px; ${i < sermons.length - 1 ? 'border-bottom: 1px solid var(--line);' : ''}`}>
            <p class="label" style="color:var(--gray); margin:0 0 8px;">{s.date} &nbsp;&middot;&nbsp; {s.passage}</p>
            <h2 style="font-size:clamp(1.6rem,3vw,2.2rem); margin-bottom:14px;">{s.title}</h2>
            <p style="font-family:var(--serif); font-size:1.05rem; max-width:64ch; margin-bottom:20px;">{s.thesis}</p>
            <audio controls preload="none" src={s.audio} style="width:100%; max-width:560px; display:block; margin-bottom:16px;"></audio>
            <a class="cta-link" href={s.page} target="_blank" rel="noopener" style="font-size:0.85rem;">Full sermon page</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="field-section" style="padding:72px 0; text-align:center;">
    <div class="wrap" style="max-width:680px;">
      <h2 class="display" style="font-size:clamp(1.6rem,3vw,2.2rem);">The whole archive, studied deeply.</h2>
      <p style="font-size:0.95rem;">Every Providence sermon &mdash; with transcripts, discussion questions, reading plans, and more &mdash; lives on Sermon Steward.</p>
      <a class="btn-outline" href="https://sermonsteward.com/ProvidenceLenexa/sermons/" target="_blank" rel="noopener">Visit the archive</a>
    </div>
  </section>
</Base>
