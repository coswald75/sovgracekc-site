---
import Base from '../layouts/Base.astro';

const values = [
  { name: 'Humility > Pride', body: 'The Lord promises to bless the one "who is humble and contrite in spirit" (Isaiah 66:2). Humility is an accurate view of God and ourselves. It is foundational to all other virtues, because without humility we will experience neither the desire nor the grace necessary to cultivate them. The gospel humbles us as we come to grasp that "by grace you have been saved through faith. And this is not your own doing; it is the gift of God, not a result of works, so that no one may boast" (Ephesians 2:8-9).' },
  { name: 'Courage > Cowardice', body: 'God expects his people to be courageous (Deut 31:6, Philippians 1:28). Courage flows from humility while cowardice flows from pride. We want to help people live authentically courageous lives as an expression of their humble trust in the God who promises to never leave them nor forsake them.' },
  { name: 'Celebration > Envy', body: "We think the scriptures present envy as a much bigger problem than most people realize. We see this sin at the root of many ancient and modern evils and believe that in the cross, Jesus made it possible to root for one another and celebrate each other's success. You'd be surprised how different a community is when envy is actively rejected!" },
  { name: 'Facts > Feelings', body: "Don't get us wrong, we think feelings matter a great deal. But sometimes our feelings and the facts don't agree, and when this happens, we want to align our feelings to the facts and not the other way around." },
  { name: 'Honesty > Spin', body: "We really try to say what we mean and mean what we say. But we have renounced disgraceful, underhanded ways. We refuse to practice cunning or to tamper with God's word, but by the open statement of the truth we would commend ourselves to everyone's conscience in the sight of God. (2 Corinthians 4:2)" },
  { name: 'Freedom > Guilt', body: 'Following their father the devil, the world uses guilt to bully people into conformity. But we have been set free in Christ and truly believe that when we confess our sins, he is faithful and just to forgive us and cleanse us from all unrighteousness.' },
];
---
<Base
  title="About | Providence Community Church | Church in Lenexa, KS."
  description="Learn more about the mission, partnerships, and core values that act as a foundation for Providence Community Church."
  path="/about/"
>
  <section class="section section-panel">
    <div class="wrap grid-2">
      <div>
        <h1 style="font-family:var(--serif); font-weight:400; font-size:1.8rem; line-height:1.4;">We are called to display truth and beauty in community.</h1>
      </div>
      <div class="photo">
        <img src="/wp-content/uploads/Providence_About_FirePit.jpg" alt="Gathering around the fire pit at Providence" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="wrap">
      <h2>Things we value.</h2>
      <div class="grid-3" style="margin-top:36px; gap:36px;">
        {values.map((v) => (
          <div>
            <h3 style="font-size:1.2rem;">{v.name}</h3>
            <p style="font-size:0.95rem;">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule section-panel">
    <div class="wrap">
      <p class="eyebrow">Partnerships</p>
      <h2 style="max-width:30ch;">United in fellowship, mission, and governance.</h2>
      <p style="max-width:62ch;">We enjoy a rich relationship with Sovereign Grace Churches worldwide, a family of churches that helps us to care for one another and advance the gospel.</p>
      <div style="display:flex; gap:48px; align-items:center; flex-wrap:wrap; margin-top:24px;">
        <a href="https://www.sovereigngrace.com/" style="display:block; max-width:240px;">
          <img src="/wp-content/uploads/2021/06/SGC-1024x343.png" alt="Sovereign Grace Churches — united in fellowship, mission, and governance" loading="lazy" />
        </a>
      </div>
      <p style="margin-top:18px;"><a class="arrow-link" href="https://www.sovereigngrace.com/">Visit Sovereign Grace Churches</a></p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="wrap">
      <p class="eyebrow">Explore Providence</p>
      <h2>What's your next step?</h2>
      <div class="grid-3" style="margin-top:36px;">
        <div>
          <h3>Read our beliefs</h3>
          <p style="font-size:0.95rem;">What we believe about the Bible instructs everything that we value as a church.</p>
          <a class="arrow-link" href="/beliefs/">Our beliefs</a>
        </div>
        <div>
          <h3>Get connected</h3>
          <p style="font-size:0.95rem;">Discover the ways you can connect and grow here at Providence.</p>
          <a class="arrow-link" href="/community/">Community</a>
        </div>
        <div>
          <h3>Plan your visit</h3>
          <p style="font-size:0.95rem;">Take the next step by learning what you can expect on a Sunday morning.</p>
          <a class="arrow-link" href="/visit/">Visit on Sunday</a>
        </div>
      </div>
    </div>
  </section>
</Base>
