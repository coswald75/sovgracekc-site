---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | Providence Community Church (Lenexa, KS)" path="/404/">
  <section class="section">
    <div class="wrap" style="max-width:720px; text-align:center; padding-top:48px; padding-bottom:48px;">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page.</h1>
      <p style="font-size:1.1rem;">The page may have moved. Here are a few good places to go next:</p>
      <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:20px;">
        <a class="btn-ghost" href="/">Homepage</a>
        <a class="btn-ghost" href="/visit/">Visit on Sunday</a>
        <a class="btn-ghost" href="/sermons/">Sermons</a>
        <a class="btn-ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</Base>
