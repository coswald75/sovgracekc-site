---
import Base from '../layouts/Base.astro';
---
<Base title="Thank You | Providence Community Church (Lenexa, KS)" path="/thank-you-2/">
  <section class="section">
    <div class="wrap" style="max-width:720px; text-align:center; padding-top:48px; padding-bottom:48px;">
      <p class="eyebrow">Message received</p>
      <h1>Thanks for sending us a message!</h1>
      <p style="font-size:1.1rem;">We'll get back to you soon.</p>
      <a class="btn" href="/" style="margin-top:12px;">Back to the homepage</a>
    </div>
  </section>
</Base>
