---
import Base from '../layouts/Base.astro';

const tools = [
  {
    kind: 'Reading plans',
    title: 'Reading Plans',
    href: '/isaiah/readplan/',
    desc: 'Reading plans that will help you work through the Book of Isaiah.',
  },
  {
    kind: 'Sermon series · Fall 2026',
    title: 'The Nations of Isaiah',
    href: '/isaiah/nations/',
    desc: 'The full companion to our fall series — foundations, twelve nation studies, an interlude on idols, three studies in statecraft, and the gathering of the peoples. Start at the hub and read straight through.',
  },
];
---
<Base
  title="Isaiah Tools | Providence Community Church (Lenexa, KS)"
  description="Resources to accompany Providence Community Church's upcoming sermon series through the book of Isaiah."
  path="/isaiah/"
>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Sermon series</p>
      <h1>The book of Isaiah.</h1>
      <p style="font-size:1.12rem;">In the late fall of 2026, Providence Community Church plans to begin an extended sermon series through the book of Isaiah. This page will hold resources useful to that study.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="res-grid">
        {tools.map((r) => (
          <a class="res-card" href={r.href}>
            <p class="res-kind">{r.kind}</p>
            <h2 class="res-title">{r.title}</h2>
            <p class="res-desc">{r.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .res-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .res-card {
      display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px;
      padding: 26px 28px; text-decoration: none; background: var(--paper);
      transition: border-color .15s, box-shadow .15s, transform .15s;
    }
    .res-card:hover { border-color: var(--ink); box-shadow: 0 10px 30px rgba(0,0,0,0.06); transform: translateY(-2px); opacity: 1; }
    .res-kind {
      font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--gray); font-weight: 700; margin: 0 0 8px;
    }
    .res-title { font-family: var(--serif); font-size: 1.5rem; margin: 0 0 10px; color: var(--ink); }
    .res-title::after { content: ' \2192'; color: var(--gray); font-size: 1.1rem; }
    .res-desc { font-size: 0.96rem; margin: 0; color: var(--ink); }
    @media (max-width: 700px) { .res-grid { grid-template-columns: 1fr; } }
  </style>
</Base>
