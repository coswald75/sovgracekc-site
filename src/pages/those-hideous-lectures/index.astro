---
import Base from '../../layouts/Base.astro';

const lectures = [
  {
    n: 'Lecture 1',
    title: 'The Severed Head',
    href: '/those-hideous-lectures/the-severed-head/',
    desc: "Headship, the body, and the two ways hierarchy dies — read through C. S. Lewis's That Hideous Strength, the Westminster divines, and the apostle Paul. Listening guide and full manuscript.",
  },
];
---
<Base
  title="Those Hideous Lectures | Providence Community Church (Lenexa, KS)"
  description="A lecture series from Providence Community Church — edifying content produced through interaction with Lewis, Tolkien, and other writers of Christendom."
  path="/those-hideous-lectures/"
>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Lecture Series</p>
      <h1>Those Hideous Lectures</h1>
      <p style="font-size:1.12rem;">Edifying content produced through interaction with Lewis, Tolkien, and other writers of Christendom.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap" style="max-width:820px;">
      <div class="thl-list">
        {lectures.map((l) => (
          <a class="thl-card" href={l.href}>
            <p class="thl-kind">{l.n}</p>
            <h2 class="thl-title">{l.title}</h2>
            <p class="thl-desc">{l.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .thl-list { display: flex; flex-direction: column; gap: 16px; }
    .thl-card {
      display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px;
      padding: 24px 26px; text-decoration: none; background: var(--paper);
      transition: border-color .15s, box-shadow .15s, transform .15s;
    }
    .thl-card:hover { border-color: var(--ink); box-shadow: 0 10px 30px rgba(0,0,0,0.06); transform: translateY(-2px); opacity: 1; }
    .thl-kind { font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); font-weight: 700; margin: 0 0 7px; }
    .thl-title { font-family: var(--serif); font-size: 1.5rem; margin: 0 0 9px; color: var(--ink); }
    .thl-title::after { content: ' \2192'; color: var(--gray); font-size: 1.05rem; }
    .thl-desc { font-size: 0.96rem; margin: 0; color: var(--ink); }
  </style>
</Base>
