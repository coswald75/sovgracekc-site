---
import Base from '../layouts/Base.astro';

const resources = [
  {
    kind: 'Course · self-paced',
    title: 'Considering Membership',
    href: '/membership/',
    desc: 'A self-paced, twenty-lesson course on what it means to belong to this church — and why belonging to any church matters at all. Read at your own pace; nothing to sign up for.',
  },
  {
    kind: 'Membership · covenant',
    title: 'The Membership Covenant',
    href: '/covenant/',
    desc: 'The promises we make to one another as members of this church — with a brief history of church covenants and the thinking behind our own.',
  },
  {
    kind: 'Worksheets · for sufferers',
    title: 'Suffering Sheets',
    href: '/suffering-sheets/',
    desc: 'Ten short worksheets for walking with God through a season of suffering — honest writing, one sheet at a time, at whatever pace your circumstances allow.',
  },
  {
    kind: 'Self-guided library',
    title: 'Study & Reflection',
    href: '/topical-resources/',
    desc: 'The rest of our self-guided library — a Bible knowledge exam, honest self-assessments, more counseling worksheets, and Vespers evening listening.',
  },
  {
    kind: 'Digital assistant',
    title: 'ProvBot',
    href: '/provbot/',
    desc: 'Our digital assistant. Ask about visiting, what we believe, or anything from Pastor Chris Oswald’s sermon archive — answered from Providence’s own material.',
  },
  {
    kind: 'Sermon series · Isaiah',
    title: 'Isaiah Tools',
    href: '/isaiah/',
    desc: 'Outfitting the congregation for our upcoming journey through the book of Isaiah.',
  },
  {
    kind: 'Lecture series',
    title: 'Those Hideous Lectures',
    href: '/those-hideous-lectures/',
    desc: 'Edifying content produced through interaction with Lewis, Tolkien, and other writers of Christendom. Begins with Lecture 1: The Severed Head.',
  },
];
---
<Base
  title="Resources | Providence Community Church (Lenexa, KS)"
  description="Resources from Providence Community Church — a self-paced membership course, plus self-guided tools for study and reflection."
  path="/resources/"
>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Resources</p>
      <h1>Grow deeper.</h1>
      <p style="font-size:1.12rem;">Tools and teaching to help you know Christ, understand this church, and take your next step &mdash; use them on your own, at your own pace.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="res-grid">
        {resources.map((r) => (
          <a class="res-card" href={r.href}>
            <p class="res-kind">{r.kind}</p>
            <h2 class="res-title">{r.title}</h2>
            <p class="res-desc">{r.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .res-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .res-card {
      display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px;
      padding: 26px 28px; text-decoration: none; background: var(--paper);
      transition: border-color .15s, box-shadow .15s, transform .15s;
    }
    .res-card:hover { border-color: var(--ink); box-shadow: 0 10px 30px rgba(0,0,0,0.06); transform: translateY(-2px); opacity: 1; }
    .res-kind {
      font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--gray); font-weight: 700; margin: 0 0 8px;
    }
    .res-title { font-family: var(--serif); font-size: 1.5rem; margin: 0 0 10px; color: var(--ink); }
    .res-title::after { content: ' \2192'; color: var(--gray); font-size: 1.1rem; }
    .res-desc { font-size: 0.96rem; margin: 0; color: var(--ink); }
    @media (max-width: 700px) { .res-grid { grid-template-columns: 1fr; } }
  </style>
</Base>
