---
import Base from '../layouts/Base.astro';

const ministries = [
  { id: 'mens-ministry', name: "Men's Ministry", img: '/wp-content/uploads/SGCAU_Connected_MensMinistry-1024x683.jpg', body: "There is no other ministry in our church that holds a place of prominence than our men's ministry. We hold regular “head of household” meetings where the elders share updates on church matters. We meet in many different contexts, some of them involving deep dives into church history and theology, other meetings focus on living prayerful joy-filled lives. We serve together, meeting the needs of the saints and people in the community. We read leadership books together and seek to process that information through a gospel-centered lens." },
  { id: 'womens-ministry', name: "Women's Ministry", img: '/wp-content/uploads/SGCAU_Connected_WomensMinistry-1024x704.jpg', body: 'We are blessed to have a vibrant ministry practicing Titus 2 inter-generational care and mentorship. There is no shortage of opportunities for the ladies of the church to study the word, read good books, swap childcare, and much more.' },
  { id: 'childrens-ministry', name: "Children's Ministry", img: '/wp-content/uploads/gallery/childrens-ministry-new.jpg', body: "We relish the opportunity to serve parents and children at Providence. Our Children's Ministry gives us a context to come alongside parents in their God-given role of planting the seeds of faith in the hearts of their children. Our goal on Sunday mornings is to build off the Biblical instruction children receive from their parents throughout the week. Overall, we desire to equip the body of Christ to spread to the next generations a passion for the supremacy of God in all things for the joy of all peoples through Jesus Christ." },
  { id: 'young-professionals', name: 'Young Professionals', img: '/wp-content/uploads/Providence_Community_YoungProfessionals.jpg', body: 'The Lord has been gracious in building a community of young adults within our local church. Our heart is to equip them to become disciple-makers within their workplace, family, and friends. Therefore, we have opened opportunities for young adults to connect and serve through bible studies, fellowship, worship nights, and serving opportunities.' },
  { id: 'small-groups', name: 'Small Groups', img: '/wp-content/uploads/Providence_Community_SmallGroups-1024x576.jpg', body: "We meet together in smaller gatherings (what we call Community Groups) to pursue biblical fellowship in a more intimate setting. That's our rhythm: large gathering, small gatherings; transcendence, intimacy; truth declared, truth applied. And it's our rhythm because we believe it's the biblical way to live life together. It's a rhythm of glory to God and joy for the saints." },
  { id: 'bridge-course', name: 'Bridge: Explore the Christian Faith', img: '/wp-content/uploads/gallery/small-group-study.jpg', body: "Why does God allow suffering? Can we really trust the Bible? Is Jesus the only way? The Bridge Course is designed to help answer these questions and explore the Christian faith in a relaxed, non-threatening environment over ten weeks. There are 30-minute talks covering questions we all wrestle with; the talks are followed by a 30-minute discussion to interact with the talk and share your perspective. It's a safe environment where you can ask whatever question you like or not say a word." },
];
---
<Base
  title="Find Community | Providence Community Church | Church in Lenexa, KS"
  description="Find out how to get connected at Providence Community Church. Learn about small groups and other ways you can get involved in the community and grow in your faith."
  path="/community/"
>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Community</p>
      <h1>Get connected.</h1>
      <p style="font-size:1.15rem;">Discover some of the ways we connect with one another and serve the community around us at Providence Community Church.</p>
    </div>
  </section>

  <section class="section section-rule" id="find-a-group" style="scroll-margin-top:24px;">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Community Groups</p>
      <h2>Find a group near you.</h2>
      <p style="font-size:1.05rem;">Our Community Groups gather on the <strong>first and third weeks</strong> of each month, in the evening, in homes across the Kansas City area &mdash; most on <strong>Wednesdays</strong>, with one Lenexa group meeting Thursdays. Most meet on the Kansas (Johnson County) side; a couple meet on the Missouri side. Here's the general lay of the land &mdash; find the area closest to you.</p>

      <div class="cg-cols">
        <div>
          <h3 class="cg-head">Kansas &middot; Johnson County</h3>
          <ul class="cg-list">
            <li><strong>Northwest Shawnee</strong> &mdash; convenient to Bonner Springs and the Legends</li>
            <li><strong>Central Lenexa</strong> &mdash; near 87th Street &amp; I-435 <span class="cg-note">(two groups here &mdash; one Wednesdays, one Thursdays)</span></li>
            <li><strong>Central Overland Park</strong> &mdash; around 103rd Street</li>
          </ul>
        </div>
        <div>
          <h3 class="cg-head">Missouri &middot; South Kansas City</h3>
          <ul class="cg-list">
            <li><strong>Near the state line</strong> &mdash; the Waldo / Wornall area (easy from Leawood, too)</li>
            <li><strong>Red Bridge area</strong> &mdash; the best fit if you're coming from further into Missouri</li>
          </ul>
        </div>
      </div>

      <p style="margin-top:24px;">Not sure which one fits? Tell us the part of town you're in and we'll point you to the nearest group. Write to <a href="mailto:info@kcprovidence.org">info@kcprovidence.org</a>, or say hello on a Sunday. You can also ask <strong>ProvBot</strong>, our website assistant &mdash; <a href="/provbot/">it can point you to the group nearest you</a>.</p>
    </div>
    <style>
      .cg-cols { display:grid; grid-template-columns:1fr 1fr; gap:36px; margin-top:28px; }
      .cg-head { font-size:0.82rem; letter-spacing:0.06em; text-transform:uppercase; margin:0 0 12px; color:var(--gray); }
      .cg-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:12px; }
      .cg-list li { font-size:0.98rem; line-height:1.5; padding-left:16px; border-left:2px solid var(--line, #e6e3db); }
      .cg-note { color:var(--gray); font-size:0.9rem; }
      @media (max-width:640px) { .cg-cols { grid-template-columns:1fr; gap:28px; } }
    </style>
  </section>

  {ministries.map((m, i) => (
    <section class="section section-rule" id={m.id} style="scroll-margin-top:24px;">
      <div class="wrap grid-2">
        {i % 2 === 0 ? (
          <>
            <div>
              <p class="eyebrow">Ministry</p>
              <h2>{m.name}</h2>
              <p style="font-size:0.98rem;">{m.body}</p>
              {m.id === 'bridge-course' && <a class="arrow-link" href="/bridge/">Learn more about the Bridge Course</a>}
            </div>
            <div class="photo"><img src={m.img} alt={m.name} loading="lazy" /></div>
          </>
        ) : (
          <>
            <div class="photo"><img src={m.img} alt={m.name} loading="lazy" /></div>
            <div>
              <p class="eyebrow">Ministry</p>
              <h2>{m.name}</h2>
              <p style="font-size:0.98rem;">{m.body}</p>
              {m.id === 'bridge-course' && <a class="arrow-link" href="/bridge/">Learn more about the Bridge Course</a>}
            </div>
          </>
        )}
      </div>
    </section>
  ))}

  <section class="section section-rule section-panel">
    <div class="wrap" style="max-width:720px; text-align:center;">
      <h2>Ready to take a step?</h2>
      <p>The best way to get connected is to join us on a Sunday morning and say hello.</p>
      <a class="btn" href="/visit/">Plan your visit</a>
    </div>
  </section>
</Base>
