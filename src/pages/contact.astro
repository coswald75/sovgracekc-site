---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact Us | Providence Community Church | Church in Lenexa, KS"
  description="Need to get in contact with Providence Community Church? Find all the relevant information you need to have your questions answered."
  path="/contact/"
>
  <section style="padding:56px 0 72px;">
    <div class="wrap">
      <h1 class="masthead" style="font-size:clamp(2.2rem,5.5vw,3.8rem);">Contact Us</h1>
      <div class="two-col">
        <p>We are eager to help you get answers to your questions and get connected with Providence Community Church. We're available 9am&ndash;5pm and we'd love to hear from you.</p>
        <div>
          <p class="label" style="margin-bottom:4px;">Email</p>
          <p style="font-family:var(--serif); font-size:1.2rem;"><a href="mailto:chris@sovgracekc.org">chris@sovgracekc.org</a></p>
          <p class="label" style="margin-bottom:4px; margin-top:18px;">Address</p>
          <p style="font-family:var(--serif); font-size:1.2rem; margin-bottom:10px;">10113 Lenexa Dr, Lenexa, KS 66215</p>
          <a class="cta-link" href="https://goo.gl/maps/UuJfdQ5WBd6SA6H5A" target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="wrap" style="max-width:680px; text-align:center;">
      <h2 class="caps-head">Ask ProvBot</h2>
      <p>We use ProvBot as a digital assistant to communicate with our pastors. Give it a try.</p>
      <a class="btn-dark" href="/provbot/">Ask ProvBot</a>
    </div>
  </section>

  <section class="field-section" style="padding:72px 0; text-align:center;">
    <div class="wrap" style="max-width:680px;">
      <h2 class="display" style="font-size:clamp(1.6rem,3vw,2.2rem);">Or just come say hello.</h2>
      <p style="font-size:0.95rem;">The best conversations happen in person. Join us Sunday at 10:00am &mdash; we'd love to meet you.</p>
      <a class="btn-outline" href="/visit/">Plan a visit</a>
    </div>
  </section>
</Base>
