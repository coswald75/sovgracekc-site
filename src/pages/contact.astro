---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact Us | Providence Community Church | Church in Lenexa, KS"
  description="Need to get in contact with Providence Community Church? Find all the relevant information you need to have your questions answered."
  path="/contact/"
>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Contact</p>
      <h1>We'd love to hear from you.</h1>
      <p style="font-size:1.15rem;">We are eager to help you get answers to your questions and get connected with Providence Community Church.</p>
    </div>
  </section>

  <section class="section section-rule">
    <div class="wrap grid-2" style="align-items:start;">
      <div>
        <p class="eyebrow">Ask a question</p>
        <h2>How can we help?</h2>
        <p>If you'd like more information about the church, have questions about how to get involved, or need prayer, please let us know. We're available 9 AM &ndash; 5 PM and we'd love to answer any questions you have.</p>
        <div style="margin-top:28px;">
          <p class="eyebrow" style="color:var(--muted); margin-bottom:4px;">Email</p>
          <p style="font-size:1.1rem;"><a href="mailto:chris@sovgracekc.org">chris@sovgracekc.org</a></p>
          <p class="eyebrow" style="color:var(--muted); margin-bottom:4px; margin-top:20px;">Address</p>
          <p style="font-size:1.1rem; margin-bottom:8px;">10113 Lenexa Dr, Lenexa, KS 66215</p>
          <a class="arrow-link" href="https://goo.gl/maps/UuJfdQ5WBd6SA6H5A">Get directions</a>
        </div>
        <div style="margin-top:32px;">
          <a class="btn" href="mailto:chris@sovgracekc.org?subject=Question%20for%20Providence%20Community%20Church">Send us a message</a>
        </div>
      </div>
      <div class="photo">
        <img src="/wp-content/uploads/Providence-Community-Church_Lenexa_Family-1024x549.jpg" alt="A family at Providence Community Church" loading="lazy" />
      </div>
    </div>
  </section>
</Base>
