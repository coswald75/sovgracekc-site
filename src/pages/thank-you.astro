---
import Base from '../layouts/Base.astro';
---
<Base title="Thank You | Providence Community Church (Lenexa, KS)" path="/thank-you/">
  <section class="section">
    <div class="wrap" style="max-width:720px; text-align:center; padding-top:48px; padding-bottom:48px;">
      <p class="eyebrow">Thank you</p>
      <h1>Thank you!</h1>
      <p style="font-size:1.1rem;">Here are a few good next steps:</p>
      <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:20px;">
        <a class="btn-ghost" href="/">Go to the homepage</a>
        <a class="btn-ghost" href="/leadership/">Meet the leadership</a>
        <a class="btn-ghost" href="/community/">Learn about Community Groups</a>
      </div>
    </div>
  </section>
</Base>
