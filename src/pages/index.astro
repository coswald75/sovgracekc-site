---
import Base from '../layouts/Base.astro';

const events = [
  { label: 'Kids & Families', name: 'Providence Kids on Sundays', img: '/wp-content/uploads/stock-kids-crafts.jpg', href: '/community/#childrens-ministry' },
  { label: "Men & Women", name: 'Ministries that meet weekly', img: '/wp-content/uploads/SGCAU_Connected_WomensMinistry-1024x704.jpg', href: '/community/' },
  { label: 'Marriage Mentorship', name: 'Couples investing in couples', img: '/wp-content/uploads/providence-marriage-mentorship-2.jpg', href: 'mailto:chris@sovgracekc.org?subject=Marriage%20Mentorship' },
];
---
<Base
  title="Providence Community Church | Gospel-Centered Church in Lenexa"
  description="Whether you're looking for a church, looking for community, or looking for answers, you're welcome at Providence Community Church."
  path="/"
>
  <section style="padding:24px 0 72px;">
    <div class="wrap hero-grid">
      <div>
        <div class="media hero-media">
          <video autoplay muted loop playsinline preload="metadata"
            poster="/media/hero-poster.jpg" id="hero-video"
            aria-label="Families arriving at Providence Community Church on a Sunday morning">
            <source src="/media/hero-loop.mp4" type="video/mp4" />
          </video>
        </div>
        <script>
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const v = document.getElementById('hero-video');
            if (v) { v.removeAttribute('autoplay'); v.pause(); }
          }
        </script>
        <div style="padding-top:32px;">
          <h1 class="masthead">Providence</h1>
          <div class="two-col">
            <p>We are a church in Lenexa, Kansas with a desire to display truth and beauty in community &mdash; and to see the gospel of Jesus Christ permeate our lives, our families, and our city.</p>
            <div>
              <p>We gather on Sundays at 10:00am at 10113 Lenexa Dr. You'll find the members here to be welcoming, friendly, and enjoying life to the fullest.</p>
              <a class="cta-link" href="/about/">Learn more</a>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-rail">
        <a class="rail-card rail-photo" href="/photos/" style="background-image:url('/wp-content/uploads/providence-vista-fourth.jpg');">
          <p class="label" style="color:#fff; margin:0; position:relative;">Photos</p>
          <div style="position:relative;">
            <h3 style="color:#fff; font-size:1.9rem; margin:0;">Our Life<br />Together</h3>
            <p style="color:rgba(255,255,255,0.75); margin:10px 0 0; font-size:0.85rem; letter-spacing:0.1em;">+++</p>
          </div>
        </a>
        <a class="rail-card rail-photo" href="/sermons/" style="background-image:url('/wp-content/uploads/gallery/sermons-tile.jpg');">
          <span></span>
          <div style="position:relative;">
            <h3 style="color:#fff; font-size:1.9rem; margin:0;">Recent<br />Sermons</h3>
            <p style="color:rgba(255,255,255,0.75); margin:10px 0 0; font-size:0.85rem; letter-spacing:0.1em;">+++</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" style="text-align:center;">
    <div class="wrap">
      <div class="badge">+++</div>
      <p style="font-family:var(--serif); font-size:1.45rem; margin:0 0 18px;">Sunday Service at 10:00am</p>
      <a class="cta-link" href="/visit/">Plan a visit</a>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap" style="position:relative;">
      <div style="display:flex; justify-content:flex-end; margin-bottom:34px;">
        <a class="cta-link" href="/community/">All ministries</a>
      </div>
      <div style="display:grid; grid-template-columns:56px 1fr; gap:24px; align-items:start;">
        <div class="side-label">Get Connected</div>
        <div class="grid-3">
          {events.map((e) => (
            <div>
              <a href={e.href} class="media" style="display:block;">
                <img src={e.img} alt={e.name} style="aspect-ratio:4/3;" loading="lazy" />
              </a>
              <p class="label" style="margin:18px 0 6px;">{e.label}</p>
              <p style="font-family:var(--serif); font-size:1.2rem; margin:0 0 10px;">{e.name}</p>
              <a class="cta-link" href={e.href} style="font-size:0.85rem;">Details</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="field-section" style="padding:88px 0;">
    <div class="wrap">
      <h2 class="display" style="margin-bottom:20px;">Truth and Beauty in Community.</h2>
      <p style="font-family:var(--serif); font-style:italic; font-size:0.95rem; margin:0;">&lsquo;Whatever is true, whatever is honorable, whatever is just, whatever is pure, whatever is lovely&hellip; think about these things.&rsquo; <span style="font-style:normal;">Philippians 4:8</span></p>
      <p style="font-size:0.92rem; color:var(--gray); margin-top:4px;">The mission of Providence Community Church</p>
      <div class="grid-3" style="margin-top:44px;">
        <div>
          <p class="label" style="margin-bottom:8px;">Truth</p>
          <p style="font-size:0.95rem;">We would rather repent than undertake the fool's errand of refashioning reality to suit our own preferences.</p>
        </div>
        <div>
          <p class="label" style="margin-bottom:8px;">Community</p>
          <p style="font-size:0.95rem;">We love to gather together, eat good food, play games, and enjoy the wholesome beauty of God's creation.</p>
        </div>
        <div>
          <p class="label" style="margin-bottom:8px;">Service</p>
          <p style="font-size:0.95rem;">We believe that serving others is fundamental to a life well-lived.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="text-align:center; max-width:720px;">
      <h2 class="display" style="font-size:clamp(1.6rem,3vw,2.2rem);">New here?</h2>
      <p style="font-size:0.98rem;">It's common for people to have questions. Dress casually or dress up &mdash; come as you are comfortable. Providence Kids serves children from infants to 8 years old, and we teach the Bible verse-by-verse, applying the truth to relationships, work, and life.</p>
      <a class="cta-link" href="/visit/">What to expect on Sunday</a>
    </div>
  </section>

  <style>
    .hero-grid { display: grid; grid-template-columns: 1fr 340px; gap: 44px; align-items: start; }
    .hero-media img, .hero-media video { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; display: block; }
    .hero-rail { display: flex; flex-direction: column; gap: 24px; }
    .rail-card { display: flex; flex-direction: column; justify-content: space-between; border-radius: 14px; text-decoration: none; overflow: hidden; }
    .rail-dark { background: #111; padding: 26px 28px; aspect-ratio: 1 / 1; }
    .rail-photo { background-size: cover; background-position: center; padding: 26px 28px; aspect-ratio: 1 / 1; position: relative; }
    .rail-photo::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.35), rgba(0,0,0,0.15) 40%, rgba(0,0,0,0.5)); }
    .hero-rail .float-card { width: 100%; aspect-ratio: auto; min-height: 340px; }
    .hero-rail .float-card h3 { font-size: 2.1rem; }
    .hero-rail .float-card .arrow { width: 52px; height: 52px; font-size: 1.3rem; }
    @media (max-width: 860px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-rail { flex-direction: row; flex-wrap: wrap; }
      .hero-rail > * { flex: 1 1 240px; }
    }
  </style>
</Base>
