---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path: string;
}

const { title, description, path } = Astro.props;
const canonical = `https://sovgracekc.org${path}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/wp-content/uploads/cropped-favicon-5-32x32.png" sizes="32x32" />
  <link rel="icon" href="/wp-content/uploads/cropped-favicon-5-192x192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/wp-content/uploads/cropped-favicon-5-180x180.png" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://sovgracekc.pages.dev/media/og-share.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://sovgracekc.pages.dev/media/og-share.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Archivo+Narrow:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HG3RG3C3QB"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HG3RG3C3QB');
    gtag('config', 'AW-11258142796');
  </script>
</head>
<body>

  <header>
    <div class="wrap top-bar">
      <input type="checkbox" id="menu-toggle" class="menu-toggle" />
      <label for="menu-toggle" class="menu-plus" aria-label="Menu"><span>+</span></label>
      <nav class="center-nav" aria-label="Primary">
        <a href="/about/" class="nav-link">About</a>
        <a href="/" class="mark" aria-label="Providence Community Church — home">
          <img src="/wp-content/uploads/providence-tree-mark-navy.png" alt="" style="height:78px; width:auto; filter:grayscale(1) brightness(0.35);" />
        </a>
        <a href="/visit/" class="nav-link">Visit</a>
      </nav>
      <nav class="full-menu" aria-label="All pages">
        <a href="/">Home</a>
        <a href="/visit/">New? Start Here</a>
        <a href="/about/">About</a>
        <a href="/beliefs/">Beliefs</a>
        <a href="/sermons/">Sermons</a>
        <a href="/community/">Community</a>
        <a href="/photos/">Photos</a>
        <a href="/leadership/">Leadership</a>
        <a href="/missions/">Missions</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
    <hr class="rule" />
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <hr class="rule" />
    <div class="wrap foot-grid">
      <div>
        <p class="label" style="margin:0 0 8px;">Providence Community Church</p>
        <p style="font-size:0.92rem; color:var(--gray); max-width:44ch;">A true family of Christians who live to make much of Jesus as we gather in community and love our neighbors in Lenexa, KS.</p>
        <p style="font-size:0.92rem; color:var(--gray);">10113 Lenexa Dr, Lenexa, KS 66215<br /><a href="mailto:chris@sovgracekc.org">chris@sovgracekc.org</a></p>
      </div>
      <div class="foot-links">
        <a href="/about/">About</a>
        <a href="/beliefs/">Beliefs</a>
        <a href="/sermons/">Sermons</a>
        <a href="/community/">Community</a>
        <a href="/photos/">Photos</a>
        <a href="/leadership/">Leadership</a>
        <a href="/missions/">Missions</a>
        <a href="/contact/">Contact</a>
      </div>
      <div style="text-align:right;">
        <a class="cta-link" href="/visit/">Plan a visit</a>
        <p style="font-size:0.85rem; color:var(--gray); margin-top:24px;">
          <a href="https://facebook.com/sovgracekc/">Facebook</a> &nbsp;/&nbsp;
          <a href="https://instagram.com/providence_churchkc">Instagram</a>
        </p>
        <p style="font-size:0.8rem; color:var(--gray);">&copy; {new Date().getFullYear()} Providence Community Church</p>
      </div>
    </div>
  </footer>

  <style>
    .top-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding-top: 34px; padding-bottom: 34px; position: relative; }
    .menu-plus { justify-self: start; font-size: 3rem; font-weight: 200; cursor: pointer; line-height: 1; user-select: none; }
    .menu-plus span { display: inline-block; transition: transform 0.2s ease; }
    .menu-toggle { display: none; }
    .menu-toggle:checked ~ .menu-plus span { transform: rotate(45deg); }
    .center-nav { display: flex; align-items: center; gap: 72px; justify-self: center; }
    .nav-link {
      font-family: var(--sans); font-weight: 700; font-size: 1.45rem;
      letter-spacing: 0.04em; text-transform: uppercase;
      text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 9px;
    }
    .full-menu {
      display: none;
      position: absolute; top: 100%; left: 28px; z-index: 100;
      background: #fff; border: 1px solid var(--line); border-radius: 10px;
      padding: 20px 28px; min-width: 240px;
      flex-direction: column; gap: 4px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }
    .menu-toggle:checked ~ .full-menu { display: flex; }
    .full-menu a {
      font-family: var(--serif); font-size: 1.35rem; text-decoration: none; padding: 6px 0;
    }
    .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding-top: 48px; padding-bottom: 40px; }
    .foot-links { display: flex; flex-direction: column; gap: 6px; }
    .foot-links a { font-family: var(--serif); font-size: 1.1rem; text-decoration: none; }
    @media (max-width: 860px) {
      .center-nav .nav-link { display: none; }
      .center-nav { gap: 0; }
      .foot-grid { grid-template-columns: 1fr; }
      .foot-grid div:last-child { text-align: left !important; }
    }
  </style>
</body>
</html>
