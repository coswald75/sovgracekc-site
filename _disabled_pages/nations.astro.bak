---
import Base from '../../layouts/Base.astro';

const items = [
  {
    featured: true,
    kind: 'Read this first',
    title: 'Why the Nations?',
    href: '/isaiah/why-the-nations/',
    desc: "The series opener — the case that God's purpose for Israel was never Israel alone, traced from Abraham's call to the last page of Revelation. Start here before the atlases.",
  },
  {
    kind: 'Places & directions',
    title: 'The Nations of Isaiah',
    href: '/isaiah/atlas/',
    desc: "A reader's atlas of the place-names — where each nation sits on the map, with a compass dial read from Jerusalem.",
  },
  {
    kind: 'Family of nations',
    title: 'The Family of Nations',
    href: '/isaiah/kinship/',
    desc: "Isaiah's kinship atlas — how the nations are related, each descending from Noah's sons, and many sitting on Abraham's own family tree.",
  },
  {
    kind: 'Gods & idols',
    title: 'The Gods of the Nations',
    href: '/isaiah/gods/',
    desc: "Isaiah's idol atlas — every oracle against a nation is, underneath, the case that its gods are nothing and the LORD alone is God.",
  },
  {
    kind: 'Into the New Testament',
    title: 'Isaiah in the New Testament',
    href: '/isaiah/new-testament/',
    desc: "Isaiah's nations and the gospel's advance — the same map reappears as the nations stream in.",
  },
  {
    kind: 'Present tense',
    title: 'The Nations Today',
    href: '/isaiah/today/',
    desc: "Where each nation sits now — its ancient arc, its modern location, and a snapshot of the present that we'll refresh as the series runs.",
  },
];
---
<Base
  title="The Nations of Isaiah | Providence Community Church (Lenexa, KS)"
  description="Companion tools for the nations of Isaiah — why they matter, their places and directions, their family ties, their gods, their New Testament appearance, and where they sit today."
  path="/isaiah/nations/"
>
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <p class="eyebrow">Isaiah Tools · The Nations</p>
      <h1>The nations of Isaiah.</h1>
      <p style="font-size:1.12rem;">Isaiah preaches to the whole map. Start with <em>Why the Nations?</em>, then keep these atlases beside your Bible &mdash; where the nations are, how they are related, the gods behind them, where they reappear in the New Testament, and where they sit today.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="res-grid">
        {items.map((r) => (
          <a class={r.featured ? 'res-card featured' : 'res-card'} href={r.href}>
            <p class="res-kind">{r.kind}</p>
            <h2 class="res-title">{r.title}</h2>
            <p class="res-desc">{r.desc}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:26px;"><a href="/isaiah/" style="font-family:var(--sans);font-size:0.9rem;color:var(--gray);">&larr; All Isaiah tools</a></p>
    </div>
  </section>

  <style>
    .res-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .res-card {
      display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 12px;
      padding: 26px 28px; text-decoration: none; background: var(--paper);
      transition: border-color .15s, box-shadow .15s, transform .15s;
    }
    .res-card:hover { border-color: var(--ink); box-shadow: 0 10px 30px rgba(0,0,0,0.06); transform: translateY(-2px); opacity: 1; }
    .res-card.featured { grid-column: 1 / -1; border-color: var(--accent); border-width: 1.5px; }
    .res-card.featured:hover { border-color: var(--accent); }
    .res-card.featured .res-kind { color: var(--accent); }
    .res-kind {
      font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--gray); font-weight: 700; margin: 0 0 8px;
    }
    .res-title { font-family: var(--serif); font-size: 1.5rem; margin: 0 0 10px; color: var(--ink); }
    .res-title::after { content: ' \2192'; color: var(--gray); font-size: 1.1rem; }
    .res-desc { font-size: 0.96rem; margin: 0; color: var(--ink); }
    @media (max-width: 700px) { .res-grid { grid-template-columns: 1fr; } }
  </style>
</Base>
