# Keep the staging hostname out of search engines; the custom domain is unaffected
https://sovgracekc.pages.dev/*
  X-Robots-Tag: noindex
https://:version.sovgracekc.pages.dev/*
  X-Robots-Tag: noindex

# The chat widget changes often (greeting, behavior). Make browsers revalidate it
# every load so greeting/prompt updates go live immediately (no 4-hour stale cache).
/chat-widget.js
  Cache-Control: public, max-age=0, must-revalidate
